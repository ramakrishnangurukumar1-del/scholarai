# Copy to .env and fill in. Local dev works with the defaults below.

# Database — SQLite (zero setup), MySQL, or PostgreSQL
DATABASE_URL=mysql+pymysql://scholarai:scholarai123@127.0.0.1:3306/scholarai
# DATABASE_URL=sqlite:///./scholarai.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

APP_ENV=dev                                   # set to "prod" in deployment
CORS_ORIGINS=http://localhost:5173            # comma-separated; add your deployed frontend URL

# Auth — REQUIRED to change for prod (server refuses to start with the default when APP_ENV=prod)
JWT_SECRET=dev-secret-change-me-in-production

# OCR — leave blank to auto-detect; set if Tesseract is installed elsewhere
TESSERACT_CMD=

# AI Review Assistant — optional. Without a key it uses a deterministic grounded answer.
GOOGLE_API_KEY=
AI_MODEL=gemini-2.0-flash
